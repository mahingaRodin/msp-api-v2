# Copy to /opt/apps/msp-api/.env on the server. Do not commit real values.
IMAGE=ghcr.io/mahingarodin/msp-api:latest
FRONTEND_IMAGE=ghcr.io/mahingarodin/multi-tenant-pos-fe.v2:latest
APP_PUBLIC_BASE_URL=http://4.168.192.169
DB_USERNAME=msp_user
DB_PASSWORD=CHANGE_ME_db_password
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
DEMO_SEED=true
POS_HTTP_PORT=80
